# The backend the app already uses. Only its /public/* endpoints are read here —
# nothing on this site needs a token.
NEXT_PUBLIC_API_BASE_URL=https://api.hellomycabs.com/api/v1

# Canonical origin. Every absolute URL (metadata, sitemap, JSON-LD) is built from this,
# so it MUST be the exact host you want indexed — a mismatch splits your ranking.
NEXT_PUBLIC_SITE_URL=https://www.hellomycabs.com
