# The backend the app already uses. Only its /public/* endpoints are read here —
# nothing on this site needs a token.
NEXT_PUBLIC_API_BASE_URL=https://api.hellomycabs.com/api/v1

# Canonical origin. Every absolute URL (metadata, sitemap, JSON-LD) is built from this,
# so it MUST be the exact host you want indexed — a mismatch splits your ranking.
NEXT_PUBLIC_SITE_URL=https://www.hellomycabs.com

# Shared secret for POST /api/revalidate — call it after a backend deploy so the site
# picks up a changed response shape instead of serving the old one for a day.
REVALIDATE_SECRET=change-me-locally

# Plausible's site domain, e.g. www.hellomycabs.com. LEAVE EMPTY everywhere except
# production: empty means no script is loaded and no event is sent, so local and preview
# traffic never lands in the real numbers.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
